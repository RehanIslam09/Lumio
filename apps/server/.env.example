# apps/server/.env.example
# Copy this file to .env and adjust values for your local environment.
# Note: The password "CHANGE_ME" below is a placeholder; set your real local password in .env.

PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://lumio:CHANGE_ME@localhost:5432/lumio
TEST_DATABASE_URL=postgresql://lumio:CHANGE_ME@localhost:5432/lumio_test
CORS_ORIGINS=http://localhost:5173

